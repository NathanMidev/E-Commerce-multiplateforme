rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN'
      );
    }

    function isSellerOwner(sellerId) {
      return isAuthenticated() && request.auth.uid == sellerId;
    }

    // Photo de profil utilisateur : users/{uid}/avatar/{fileName}
    // - Lecture autorisée pour afficher l'avatar du vendeur sur les fiches et boutiques
    // - Écriture/Remplacement/Suppression réservée exclusivement à l'utilisateur propriétaire {uid}
    match /users/{uid}/avatar/{fileName} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == uid &&
                   (request.resource == null || (
                     request.resource.size <= 5 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*')
                   ));
    }

    // Images classiques des produits locaux : products/{sellerId}/{productId}/images/{imageFile}
    // - Lecture autorisée pour les produits publiés (ou propriétaire / admin)
    // - Écriture/Suppression réservée exclusivement au vendeur propriétaire {sellerId} (isolation inter-vendeurs) ou admin
    match /products/{sellerId}/{productId}/images/{imageFile} {
      allow read: if true;
      allow write: if (isSellerOwner(sellerId) || isAdmin()) &&
                   (request.resource == null || (
                     request.resource.size <= 15 * 1024 * 1024 &&
                     request.resource.contentType.matches('image/.*')
                   ));
    }

    // Modèle 3D .glb du produit local : products/{sellerId}/{productId}/model/model.glb
    // - Seul le fichier model.glb (max 50 Mo) est autorisé
    // - Un vendeur ne peut jamais modifier ou supprimer le modèle .glb d'un autre vendeur
    match /products/{sellerId}/{productId}/model/model.glb {
      allow read: if true;
      allow write: if (isSellerOwner(sellerId) || isAdmin()) &&
                   (request.resource == null || (
                     request.resource.size > 12 &&
                     request.resource.size <= 50 * 1024 * 1024 &&
                     (request.resource.contentType == 'model/gltf-binary' ||
                      request.resource.contentType == 'application/octet-stream')
                   ));
    }

    // Ancien dossier de scan automatique (désactivé)
    match /scans/{uid}/{jobId}/{allPaths=**} {
      allow read, write: if false;
    }

    // Refuser tout autre chemin ou format arbitraire
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
