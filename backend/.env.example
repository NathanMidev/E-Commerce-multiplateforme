# Copiez ce fichier en ".env" (docker compose le lit automatiquement) et adaptez-le.

# --- PostgreSQL (base partagée par l'app Android et la version web)
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=changez-moi
POSTGRES_DB=marketplace

# --- Authentification
# "firebase" : vérifie les jetons Firebase des utilisateurs (valeur à utiliser en vrai).
# "dev"      : ESSAI LOCAL SANS FIREBASE uniquement. N'importe qui peut se faire passer pour n'importe
#              quel utilisateur avec l'en-tête X-Dev-Uid. Refusé si NODE_ENV=production.
AUTH_MODE=firebase

# project_id de votre fichier google-services.json (obligatoire si AUTH_MODE=firebase)
FIREBASE_PROJECT_ID=votre-project-id

# --- Version web : origines autorisées (séparées par des virgules), ex : https://monsite.mg
# L'application Android n'est pas concernée par CORS.
CORS_ORIGINS=
