<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <!-- En-tête AppBar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:background="#1976D2"
        android:elevation="4dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_title"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/main_subtitle"
            android:textColor="#BBDEFB"
            android:textSize="14sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Carte Info Architecture -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="10dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Organisation Modulaire Découplée"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#1976D2" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="• Tests unitaires indépendants (modules isolés)\n• Routeur centralisé (RouterRegistry)\n• Traitement 3D via Firebase &amp; Meta SAM\n• Backend PostgreSQL"
                        android:textSize="13sp"
                        android:lineSpacingExtra="3dp"
                        android:textColor="#616161"
                        android:layout_marginTop="6dp" />
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Bouton Catalogue & Filtres Produits -->
            <Button
                android:id="@+id/btn_nav_catalog"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_nav_catalog"
                android:textSize="15sp"
                android:backgroundTint="#1976D2"
                android:layout_marginBottom="12dp" />

            <!-- Bouton Scanner 3D Vendeur (SAM Meta) -->
            <Button
                android:id="@+id/btn_nav_scanner"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_nav_scanner"
                android:textSize="15sp"
                android:backgroundTint="#5E35B1"
                android:layout_marginBottom="12dp" />

            <!-- Bouton Messagerie Vendeurs -->
            <Button
                android:id="@+id/btn_nav_chat"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_nav_chat"
                android:textSize="15sp"
                android:backgroundTint="#00897B"
                android:layout_marginBottom="12dp" />

            <!-- Bouton Authentification & Profil -->
            <Button
                android:id="@+id/btn_nav_auth"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_nav_auth"
                android:textSize="15sp"
                android:backgroundTint="#455A64"
                android:layout_marginBottom="12dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
