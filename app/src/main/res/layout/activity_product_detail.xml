<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/layout_bottom_actions"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Galerie d'images classiques du produit + Indicateur « 3D » -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:background="#F3F4F6">

                <ImageView
                    android:id="@+id/iv_detail_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Photo de l'article"
                    android:scaleType="centerCrop" />

                <!-- Petit indicateur « 3D » lorsque le produit possède un modèle GLB -->
                <TextView
                    android:id="@+id/tv_detail_3d_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="14dp"
                    android:background="#E60070BA"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="3D"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </FrameLayout>

            <!-- Miniatures de la galerie d'images classiques -->
            <HorizontalScrollView
                android:id="@+id/scroll_image_thumbnails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:scrollbars="none"
                android:visibility="gone">

                <LinearLayout
                    android:id="@+id/layout_image_thumbnails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 2. Visualiseur 3D Interactif (.glb) + Bouton AR en haut à droite (Visible UNIQUEMENT si modèle GLB valide) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/card_3d_viewer_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="14dp"
                    android:visibility="gone"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#00897B"
                    app:strokeWidth="1.5dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Zone de visualisation 3D avec icône AR discrète en haut à droite (Sections 5 & 6) -->
                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="260dp"
                            android:background="#F8FAFC">

                            <com.marketplace.app.feature.ar.Interactive3dModelView
                                android:id="@+id/view_interactive_3d"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <ProgressBar
                                android:id="@+id/progress_3d_loading"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:layout_gravity="center"
                                android:visibility="gone" />

                            <!-- Étiquette haut-gauche du visualiseur 3D -->
                            <TextView
                                android:id="@+id/tv_3d_viewer_info"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="top|start"
                                android:layout_margin="10dp"
                                android:background="#CC1E293B"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Modèle 3D (.glb) • Rotation &amp; Zoom"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold" />

                            <!-- Petite icône AR discrète en haut à droite du visualiseur 3D (Section 6) -->
                            <ImageButton
                                android:id="@+id/btn_ar_top_right_icon"
                                android:layout_width="42dp"
                                android:layout_height="42dp"
                                android:layout_gravity="top|end"
                                android:layout_margin="10dp"
                                android:background="@drawable/bg_import1688_center_fab"
                                android:backgroundTint="#00897B"
                                android:contentDescription="Ouvrir en Réalité Augmentée ARCore"
                                android:elevation="4dp"
                                android:padding="8dp"
                                android:scaleType="centerInside"
                                android:src="@drawable/ic_ar_cube_top_right"
                                android:visibility="gone" />
                        </FrameLayout>

                        <!-- Barre d'outils rapide du visualiseur 3D -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="#FFFFFF"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="8dp">

                            <Button
                                android:id="@+id/btn_3d_zoom_out"
                                style="@style/Widget.Marketplace.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:text="Zoom -"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btn_3d_zoom_in"
                                style="@style/Widget.Marketplace.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginStart="6dp"
                                android:text="Zoom +"
                                android:textSize="11sp" />

                            <Button
                                android:id="@+id/btn_3d_reset_view"
                                style="@style/Widget.Marketplace.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="34dp"
                                android:layout_marginStart="6dp"
                                android:text="Réinitialiser vue"
                                android:textSize="11sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 3. Bloc Prix & Statut Commercial -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#EDEDED"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_detail_price"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0 Ar"
                                android:textColor="@color/price_color"
                                android:textSize="26sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_detail_status"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="#E8F5E9"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="DISPONIBLE"
                                android:textColor="#2E7D32"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_detail_title"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Titre du Produit"
                            android:textColor="@color/text_primary"
                            android:textSize="18sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_detail_stock"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="En stock : 5 unités disponibles"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />

                        <!-- Action Vendeur propriétaire : Modifier l'annonce / Gérer le fichier .glb -->
                        <Button
                            android:id="@+id/btn_edit_product_media"
                            style="@style/Widget.Marketplace.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="10dp"
                            android:text="✏️ Modifier le produit / Gérer le modèle .glb"
                            android:textSize="12sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 4. Fiche Vendeur style Deal.mg -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/layout_seller_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#EDEDED"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/iv_seller_avatar"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:contentDescription="Photo du vendeur"
                                android:scaleType="centerCrop"
                                android:src="@drawable/ic_default_avatar" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_detail_seller"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Boutique Vendeur"
                                    android:textColor="@color/text_primary"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_seller_city"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="📍 Antananarivo, Madagascar"
                                    android:textColor="@color/text_secondary"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <Button
                                android:id="@+id/btn_visit_boutique"
                                style="@style/Widget.Marketplace.Button.Outlined"
                                android:layout_width="wrap_content"
                                android:layout_height="36dp"
                                android:paddingHorizontal="10dp"
                                android:text="Boutique >"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Button
                            android:id="@+id/btn_seller_facebook"
                            style="@style/Widget.Marketplace.Button.Outlined"
                            android:layout_width="match_parent"
                            android:layout_height="36dp"
                            android:layout_marginTop="10dp"
                            android:text="🌐 Profil Facebook du vendeur"
                            android:textSize="11sp"
                            android:visibility="gone" />

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- 5. Description Détaillée -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="16dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="1dp"
                    app:strokeColor="#EDEDED"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Description de l'annonce"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_detail_description"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:lineSpacingExtra="5dp"
                            android:text="Description détaillée de l'article..."
                            android:textColor="#374151"
                            android:textSize="14sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- 6. Barre d'action fixe sous le pouce style Deal.mg -->
    <LinearLayout
        android:id="@+id/layout_bottom_actions"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <Button
            android:id="@+id/btn_action_chat"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.1"
            android:backgroundTint="#25D366"
            android:paddingHorizontal="6dp"
            android:text="💬 Contacter"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_action_add_cart"
            style="@style/Widget.Marketplace.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.1"
            android:paddingHorizontal="6dp"
            android:text="🛒 Au panier"
            android:textSize="12sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_action_checkout"
            style="@style/Widget.Marketplace.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1.2"
            android:paddingHorizontal="6dp"
            android:text="Commander"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

</RelativeLayout>
