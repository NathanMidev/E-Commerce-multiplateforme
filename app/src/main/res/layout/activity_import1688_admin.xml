<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <!-- Top App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/text_primary"
        android:elevation="4dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Retour"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/surface" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Admin • Agence Import 1688"
            android:textColor="@color/surface"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Access Control Status Banner -->
    <LinearLayout
        android:id="@+id/banner_admin_access"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/badge_pro_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <TextView
            android:id="@+id/txt_admin_access_state"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Contrôle d'accès Admin : Vérification..."
            android:textColor="@color/badge_pro_text"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_toggle_demo_admin"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="[Simulé: Activer Admin]"
            android:textAllCaps="false"
            android:textColor="@color/primary"
            android:textSize="11sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Blocked View for Non-Admin Users -->
    <LinearLayout
        android:id="@+id/layout_access_denied"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACCÈS REFUSÉ (403)"
            android:textColor="@color/status_red"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:text="Cet espace est strictement réservé aux administrateurs de l'agence Import 1688.\nUn client standard ne peut modifier ni le taux de change, ni les paiements MVola, ni les achats 1688, ni le suivi."
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Authorized Admin Content -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/scroll_admin_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="14dp">

            <!-- 1. Exchange Rate, MVola & Importer Settings Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="1. Configuration Taux CNY→MGA, MVola &amp; Importateur"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edt_cfg_rate"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_pill"
                            android:hint="Taux 1 CNY en Ar"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp" />

                        <EditText
                            android:id="@+id/edt_cfg_fee_percent"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_pill"
                            android:hint="Commission (%)"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/edt_cfg_mvola_phone"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_pill"
                        android:hint="Numéro MVola Agence"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edt_cfg_importer_name"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_pill"
                        android:hint="Nom / Société de l'importateur"
                        android:inputType="textCapWords"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edt_cfg_importer_phone"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_pill"
                        android:hint="Téléphone de l'importateur"
                        android:inputType="phone"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp" />

                    <EditText
                        android:id="@+id/edt_cfg_importer_address"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_search_pill"
                        android:hint="Adresse de retrait chez l'importateur"
                        android:inputType="textPostalAddress"
                        android:paddingHorizontal="12dp"
                        android:textSize="13sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_save_config"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="10dp"
                        android:text="Enregistrer Taux &amp; Coordonnées Importateur"
                        android:textAllCaps="false"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/primary"
                        app:cornerRadius="8dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. Search & Select Order -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="2. Rechercher et sélectionner une commande"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edt_admin_search"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_pill"
                            android:hint="Rechercher par N° commande ou nom client..."
                            android:inputType="text"
                            android:paddingHorizontal="12dp"
                            android:textSize="13sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_admin_search"
                            android:layout_width="wrap_content"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:text="Filtrer"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:backgroundTint="@color/text_primary" />
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recycler_admin_orders"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Selected Order Management Panel -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_selected_order_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="@color/surface"
                app:cardCornerRadius="12dp"
                app:cardElevation="3dp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/txt_selected_order_header"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Action sur la commande #IMP-1688-001"
                        android:textColor="@color/primary_dark"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txt_selected_order_meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_secondary"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_open_1688"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="8dp"
                        android:text="Ouvrir le lien 1688 original du produit"
                        android:textAllCaps="false"
                        android:textColor="@color/primary"
                        android:textSize="12sp" />

                    <!-- A. Confirm Final Amount -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="A. Confirmer le montant définitif (avant paiement MVola)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edt_confirm_price_cny"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_pill"
                            android:hint="Prix unitaire ¥"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="10dp"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/edt_confirm_fee_mga"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_pill"
                            android:hint="Frais Agence (Ar)"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="10dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_confirm_amount"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:text="Confirmer le montant final au client"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:backgroundTint="@color/primary" />

                    <!-- B. Verify MVola Payment -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:id="@+id/txt_admin_mvola_ref"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="B. Vérification paiement MVola • Réf : -"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_admin_mvola_approve"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_weight="1"
                            android:text="Confirmer MVola (PAYÉ)"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:backgroundTint="@color/status_green" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_admin_mvola_reject"
                            android:layout_width="0dp"
                            android:layout_height="42dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="Refuser (ÉCHOUÉ)"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            app:backgroundTint="@color/status_red" />
                    </LinearLayout>

                    <!-- C. Record Real 1688 Purchase by Agency Card -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="C. Enregistrer l'achat réel effectué sur 1688 (Carte Agence)"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_supplier_order_ref"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_pill"
                        android:hint="Réf. commande fournisseur 1688 (ex: 1688-CN-2026...)"
                        android:inputType="textCapCharacters"
                        android:paddingHorizontal="10dp"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="horizontal">

                        <EditText
                            android:id="@+id/edt_actual_purchase_cny"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_pill"
                            android:hint="Prix réel payé ¥ (CNY)"
                            android:inputType="numberDecimal"
                            android:paddingHorizontal="10dp"
                            android:textSize="12sp" />

                        <EditText
                            android:id="@+id/edt_purchase_date"
                            android:layout_width="0dp"
                            android:layout_height="40dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_search_pill"
                            android:hint="Date (YYYY-MM-DD)"
                            android:inputType="date"
                            android:paddingHorizontal="10dp"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_admin_record_purchase"
                        android:layout_width="match_parent"
                        android:layout_height="42dp"
                        android:layout_marginTop="6dp"
                        android:text="Valider ACHAT_EFFECTUÉ sur 1688"
                        android:textAllCaps="false"
                        android:textSize="12sp"
                        app:backgroundTint="@color/badge_3d_text" />

                    <!-- D. Advance Tracking Status -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="10dp"
                        android:background="@color/divider" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="D. Mettre à jour le statut d'acheminement vers l'importateur"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <EditText
                        android:id="@+id/edt_tracking_note"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="6dp"
                        android:background="@drawable/bg_search_pill"
                        android:hint="Note de suivi (ex: Colis remis au transitaire Guangzhou)"
                        android:inputType="textCapSentences"
                        android:paddingHorizontal="10dp"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_status_prep"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:text="Étape 4 : PREPARATION_FOURNISSEUR"
                            android:textAllCaps="false"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_status_shipped"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="4dp"
                            android:text="Étape 5 : EXPEDIE_VERS_IMPORTATEUR"
                            android:textAllCaps="false"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_status_received"
                            android:layout_width="match_parent"
                            android:layout_height="42dp"
                            android:layout_marginTop="4dp"
                            android:text="Étape 6 (Finale) : RECU_PAR_IMPORTATEUR"
                            android:textAllCaps="false"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/status_green" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
