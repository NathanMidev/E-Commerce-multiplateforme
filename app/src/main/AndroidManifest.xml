<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Déclaration facultative ARCore -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />

    <application
        android:name=".MarketplaceApp"
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marketplace">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentification & Profil -->
        <activity android:name=".feature.auth.LoginActivity" android:exported="false" />
        <activity android:name=".feature.auth.RegisterActivity" android:exported="false" />
        <activity android:name=".feature.auth.ProfileActivity" android:exported="false" />

        <!-- Catalogue & Boutique -->
        <activity android:name=".feature.catalogue.CatalogueActivity" android:exported="false" />
        <activity android:name=".feature.catalogue.ProductDetailActivity" android:exported="false" />
        <activity android:name=".feature.catalogue.ProductPublishActivity" android:exported="false" />
        <activity android:name=".feature.boutique.BoutiqueActivity" android:exported="false" />

        <!-- Transactions : Panier, Caisse, Commandes -->
        <activity android:name=".transaction.panier.CartActivity" android:exported="false" />
        <activity android:name=".transaction.commande.CheckoutActivity" android:exported="false" />
        <activity android:name=".transaction.commande.OrdersActivity" android:exported="false" />

        <!-- Scanner 3D & AR -->
        <activity android:name=".feature.scan3d.ScanCaptureActivity" android:exported="false" />
        <activity android:name=".feature.scan3d.ScanStatusActivity" android:exported="false" />
        <activity android:name=".feature.ar.ArViewerActivity" android:exported="false" />

    </application>

</manifest>
