<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Déclaration facultative ARCore et visibilité du package Google Play Services for AR (Android 11+) -->
    <uses-feature android:name="android.hardware.camera.ar" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <package android:name="com.google.ar.core" />
    </queries>

    <application
        android:name=".MarketplaceApp"
        android:allowBackup="true"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@android:drawable/sym_def_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Marketplace">

        <!-- Métadonnée officielle obligatoire pour initialiser ARCore (Google Play Services for AR) -->
        <meta-data
            android:name="com.google.ar.core"
            android:value="optional" />

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentification & Profil -->
        <activity android:name=".feature.auth.LoginActivity" android:exported="false" />
        <activity android:name=".feature.auth.RegisterActivity" android:exported="false" />
        <activity android:name=".feature.auth.ProfileActivity" android:exported="false" />

        <!-- Catalogue & Boutique -->
        <activity android:name=".feature.catalogue.CatalogueActivity" android:exported="false" />
        <activity android:name=".feature.catalogue.ProductDetailActivity" android:exported="false" />
        <activity android:name=".feature.catalogue.ProductPublishActivity" android:exported="false" />
        <activity android:name=".feature.boutique.BoutiqueActivity" android:exported="false" />

        <!-- Transactions : Panier, Caisse, Commandes -->
        <activity android:name=".transaction.panier.CartActivity" android:exported="false" />
        <activity android:name=".transaction.commande.CheckoutActivity" android:exported="false" />
        <activity android:name=".transaction.commande.OrdersActivity" android:exported="false" />

        <!-- Scanner 3D & AR -->
        <activity android:name=".feature.scan3d.ScanCaptureActivity" android:exported="false" />
        <activity android:name=".feature.scan3d.ScanStatusActivity" android:exported="false" />
        <activity android:name=".feature.ar.ArViewerActivity" android:exported="false" />

        <!-- Service d'Achat Agence Import 1688 -->
        <activity
            android:name=".feature.import1688.Import1688HomeActivity"
            android:exported="true"
            android:label="Import 1688">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name=".feature.import1688.Import1688BrowserActivity" android:exported="false" />
        <activity android:name=".feature.import1688.Import1688RequestActivity" android:exported="false" />
        <activity android:name=".feature.import1688.Import1688OrderDetailActivity" android:exported="false" />
        <activity android:name=".feature.import1688.Import1688AdminActivity" android:exported="false" />
        <activity android:name=".feature.faq.FaqActivity" android:exported="false" />

    </application>

</manifest>
