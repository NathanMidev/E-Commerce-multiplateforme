rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        request.auth.token.role == 'ADMIN'
      );
    }

    // Métadonnées médias et modèles 3D .glb des produits de la marketplace locale
    // - Les acheteurs peuvent consulter uniquement les produits publiés (published == true)
    // - Les produits non publiés ne sont lisibles que par leur vendeur propriétaire ou un admin
    // - Seul le vendeur propriétaire (sellerId == request.auth.uid) ou un admin peut créer/modifier/supprimer
    match /product_media/{productId} {
      allow read: if (resource != null && resource.data.published == true) ||
                  (isAuthenticated() && resource != null && resource.data.sellerId == request.auth.uid) ||
                  isAdmin();

      allow create: if isAuthenticated() &&
                    request.resource.data.sellerId == request.auth.uid &&
                    (!request.resource.data.has3DModel || request.resource.data.model3dFormat == 'glb');

      allow update: if isAuthenticated() &&
                    (resource.data.sellerId == request.auth.uid || isAdmin()) &&
                    request.resource.data.sellerId == resource.data.sellerId &&
                    (!request.resource.data.has3DModel || request.resource.data.model3dFormat == 'glb');

      allow delete: if isAuthenticated() &&
                    (resource.data.sellerId == request.auth.uid || isAdmin());
    }

    // Métadonnées complémentaires du profil utilisateur (username unique, sans aucun secret/token/mot de passe)
    match /user_profiles/{uid} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                            request.auth.uid == uid &&
                            request.resource.data.uid == uid &&
                            !('password' in request.resource.data) &&
                            !('idToken' in request.resource.data) &&
                            !('token' in request.resource.data);
      allow delete: if isAuthenticated() && request.auth.uid == uid;
    }

    // Réservation d'unicité des noms d'utilisateur (@username)
    match /usernames/{username} {
      allow read: if true;
      allow create, update: if isAuthenticated() &&
                            request.resource.data.uid == request.auth.uid &&
                            (resource == null || resource.data.uid == request.auth.uid);
      allow delete: if isAuthenticated() && resource.data.uid == request.auth.uid;
    }

    // Ancien pont scan_jobs (désactivé dans le parcours utilisateur, conservé en lecture/écriture restreinte)
    match /scan_jobs/{jobId} {
      allow read, write: if false;
    }

    // Tout autre accès non explicite est interdit
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
