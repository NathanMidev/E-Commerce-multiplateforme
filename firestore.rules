rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Règles de sécurité pour le pont de scan 3D (projet bizinevo-3d)
    // Seul un utilisateur authentifié peut créer et consulter ses propres tâches scan_jobs/{jobId}.
    match /scan_jobs/{jobId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.userId == request.auth.uid ||
        request.auth.token.admin == true
      );
      allow delete: if false;
    }

    // Tout autre accès non explicite est interdit (le métier principal passe par l'API REST)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
